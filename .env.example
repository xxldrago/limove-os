# --- База данных ---
# Внутри контейнера app/db; локально для Prisma CLI используй localhost:5433
DATABASE_URL=postgresql://limove:limove_pass@db:5432/limove?schema=public

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-in-production

# --- Мастер-ключ AES-256-GCM (64 hex символа = 32 байта) ---
# Обязателен для шифрования паролей доступов к проектам. Не меняй после создания данных!
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Telegram-бот (опционально, для Фазы 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=